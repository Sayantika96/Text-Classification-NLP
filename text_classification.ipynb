    "import React, { useState } from \"react\";\n",
    "import { Card, CardContent } from \"@/components/ui/card\";\n",
    "import { Button } from \"@/components/ui/button\";\n",
    "import { Select, SelectItem } from \"@/components/ui/select\";\n",
    "import { Input } from \"@/components/ui/input\";\n",
    "import { Bar } from \"recharts\";\n",
    "\n",
    "const models = [\n",
    "  \"Logistic Regression\",\n",
    "  \"SVM\",\n",
    "  \"Random Forest\",\n",
    "  \"XGBoost\",\n",
    "  \"MLP Neural Network\",\n",
    "];\n",
    "\n",
    "export default function TextClassificationUI() {\n",
    "  const [text, setText] = useState(\"\");\n",
    "  const [selectedModel, setSelectedModel] = useState(models[0]);\n",
    "  const [prediction, setPrediction] = useState(null);\n",
    "  const [accuracyData, setAccuracyData] = useState([]);\n",
    "\n",
    "  const classifyText = async () => {\n",
    "    // Simulating API call\n",
    "    const response = await fetch(\"/api/classify\", {\n",
    "      method: \"POST\",\n",
    "      headers: { \"Content-Type\": \"application/json\" },\n",
    "      body: JSON.stringify({ text, model: selectedModel }),\n",
    "    });\n",
    "    const data = await response.json();\n",
    "    setPrediction(data.prediction);\n",
    "    setAccuracyData(data.accuracyData);\n",
    "  };\n",
    "\n",
    "  return (\n",
    "    <div className=\"p-6 max-w-2xl mx-auto\">\n",
    "      <Card>\n",
    "        <CardContent>\n",
    "          <h2 className=\"text-xl font-bold mb-4\">Text Classification</h2>\n",
    "          <Input\n",
    "            placeholder=\"Enter text for classification\"\n",
    "            value={text}\n",
    "            onChange={(e) => setText(e.target.value)}\n",
    "            className=\"mb-4\"\n",
    "          />\n",
    "          <Select value={selectedModel} onChange={setSelectedModel} className=\"mb-4\">\n",
    "            {models.map((model) => (\n",
    "              <SelectItem key={model} value={model}>\n",
    "                {model}\n",
    "              </SelectItem>\n",
    "            ))}\n",
    "          </Select>\n",
    "          <Button onClick={classifyText} className=\"w-full\">\n",
    "            Classify Text\n",
    "          </Button>\n",
    "          {prediction && (\n",
    "            <div className=\"mt-4 p-4 bg-gray-100 rounded-lg\">\n",
    "              <h3 className=\"font-semibold\">Prediction: {prediction}</h3>\n",
    "            </div>\n",
    "          )}\n",
    "        </CardContent>\n",
    "      </Card>\n",
    "      {accuracyData.length > 0 && (\n",
    "        <div className=\"mt-6\">\n",
    "          <h3 className=\"text-lg font-semibold\">Model Performance</h3>\n",
    "          <Bar data={accuracyData} />\n",
    "        </div>\n",
    "      )}\n",
    "    </div>\n",
    "  );\n",
    "}"
   ]
  },
